{
  "name": "gainsmap-backend",
  "version": "1.0.0",
  "description": "GainsMap Backend — Modular Monolith API with Node.js and Prisma",
  "main": "src/main/server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/main/server.js",
    "start": "node src/main/server.js",
    "lint": "eslint .",
    "lint:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "test": "node --test test/**/*.test.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "node prisma/seed.js"
  },
  "keywords": [
    "gainsmap",
    "workout-tracker",
    "modular-monolith",
    "prisma",
    "nodejs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "dependency-cruiser": "^16.4.0",
    "eslint": "^9.15.0",
    "prisma": "^5.22.0"
  }
}
